# Copy to .env before using docker compose in a shared environment.
# Never commit the resulting .env file.
ACTUATOR_USERNAME=actuator
ACTUATOR_PASSWORD=replace-with-a-long-random-password

# Comma-separated SHA-256 hashes of accepted API keys. Generate each hash with:
#   printf 'your-api-key' | sha256sum
# Do not put plaintext API keys here.
API_KEY_SHA256_HASHES=replace-with-64-character-sha256-hex-digest
